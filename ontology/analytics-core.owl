  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ru">нормированная оценка направленного эффекта</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#InfluenceAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="ru">Компактное числовое значение CE. При явном ceResult должно совпадать с ceResult/numericValue; проверяется SHACL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#FixedParameter">
    <rdfs:comment xml:lang="ru">Определение параметра, фиксированного в рассматриваемой постановке модели/эксперимента; не объявляется аналитическим фактором этого анализа.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Фиксированный параметр модели</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n499cb77f6ced4686b04c604702771a90b27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/km-energy/ontology#usesModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#weight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ru">вес ребра</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#MapEdge"/>
