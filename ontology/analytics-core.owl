    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#MapEdge"/>
    <rdfs:range rdf:resource="https://w3id.org/km-energy/ontology#FactorNode"/>
    <rdfs:label xml:lang="ru">имеет исходный узел</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#effectNormalization">
