    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b26"/>
    <rdfs:comment xml:lang="ru">Правило классификации по сочетанию ST и модуля CE, представленное матрицей ST×CE. Категории — экземпляры LinkCategory; пороговый отбор рёбер задаётся отдельно у карты.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#factorVariation">
