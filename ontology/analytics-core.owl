  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#characterizesContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#SensitivityIndex"/>
