  </rdf:Description>
  <rdf:Description rdf:nodeID="n499cb77f6ced4686b04c604702771a90b72">
    <rdf:first rdf:resource="https://w3id.org/km-energy/ontology#EstimationSpecification"/>
    <rdf:rest rdf:nodeID="n499cb77f6ced4686b04c604702771a90b73"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#plansExperiment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#ExperimentPlan"/>
    <rdfs:range rdf:resource="https://w3id.org/km-energy/ontology#Experiment"/>
