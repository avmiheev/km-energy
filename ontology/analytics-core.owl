  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#InfluenceAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Оценка влияния фактора на показатель</rdfs:label>
