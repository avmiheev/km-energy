  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#CompleteAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Оценка с заполненным паспортом</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b1"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b2"/>
