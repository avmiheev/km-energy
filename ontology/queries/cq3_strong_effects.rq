PREFIX a: <https://w3id.org/km-energy/ontology#>
PREFIX ex: <https://w3id.org/km-energy/example#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# CQ3. The strong-effect boundary comes from the assessment's table-1 rule.
# Equality is included here; the map selection in CQ4 is strict.
SELECT ?assessment ?factor ?factorLabel ?ce ?absoluteCE WHERE {
 VALUES ?experiment { ex:italyExperiment }
 VALUES ?indicator { ex:profit_eur }
 ?assessment a:experiment ?experiment; a:indicator ?indicator;
             a:factor ?factor; a:ce ?ce; a:rule ?rule.
 ?rule a:ceStrong ?minimumMagnitude.
 ?factor rdfs:label ?factorLabel.
 BIND(ABS(?ce) AS ?absoluteCE)
 FILTER(?absoluteCE >= ?minimumMagnitude)
}
ORDER BY DESC(?absoluteCE) ?factor
