    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://w3id.org/km-energy/ontology#treatmentValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#target">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ru">целевой показатель ребра</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#MapEdge"/>
    <rdfs:range rdf:resource="https://w3id.org/km-energy/ontology#OutputIndicator"/>
    <rdfs:comment xml:lang="ru">Компактная ссылка ребра на сам показатель. При явном targetNode должна совпадать с targetNode/representsIndicator; проверяется SHACL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#sigmaY">
