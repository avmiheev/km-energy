PREFIX a: <https://w3id.org/km-energy/ontology#>
PREFIX ex: <https://w3id.org/km-energy/example#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# CQ3. The illustrative magnitude threshold is inclusive and preserves CE sign.
SELECT ?assessment ?factor ?factorLabel ?ce ?absoluteCE WHERE {
 VALUES (?experiment ?indicator ?minimumMagnitude) { (ex:italyExperiment ex:profit 0.4) }
 ?assessment a:experiment ?experiment; a:indicator ?indicator; a:factor ?factor; a:ce ?ce.
 ?factor rdfs:label ?factorLabel.
 BIND(ABS(?ce) AS ?absoluteCE)
 FILTER(?absoluteCE >= ?minimumMagnitude)
}
ORDER BY DESC(?absoluteCE) ?factor
