    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b9"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/km-energy/ontology#InfluenceAssessment"/>
    <rdfs:comment xml:lang="ru">Технический профиль записи для указанного в приложении линейного оценивателя: обязательные метаданные и результаты. Полнота полей не доказывает научную корректность или воспроизводимость. Не дополнительный блок рисунка 1.</rdfs:comment>
  </rdf:Description>
