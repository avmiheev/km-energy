    <rdfs:subClassOf rdf:nodeID="Nf646bf3abfab42c4857d1e9ae55accbb"/>
    <owl:disjointWith rdf:resource="https://w3id.org/km-energy/ontology#OutputIndicator"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#reportSupportsDecision">
