PREFIX a: <https://w3id.org/km-energy/ontology#>
PREFIX ex: <https://w3id.org/km-energy/example#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# CQ6. Report both selected and excluded assessments. Missing metadata stays
# unbound: no invented estimator, formula, ATE, sigma or treatment contrast.
SELECT ?assessment ?factorLabel ?indicatorLabel ?st ?ce ?category ?status
       ?tauST ?tauCE ?selected ?hasEdge ?reason ?sourceLocator ?evidenceNote
       ?method ?softwareVersion ?formula ?ate ?sigmaX ?sigmaY ?controlValue ?treatmentValue
       ?sensitivityMethod ?sensitivityVersion ?sensitivitySettings
WHERE {
 VALUES ?report { ex:demoReport }
 ?report a:reportMap ?map; a:reportAssessment ?assessment.
 ?map a:mapExperiment ?experiment; a:mapRule ?rule;
      a:candidateAssessment ?assessment; a:tauST ?tauST; a:tauCE ?tauCE;
      a:selectionOperator ">".
 ?assessment a:experiment ?experiment; a:rule ?rule;
             a:factor ?factor; a:indicator ?indicator; a:status ?status.
 ?factor rdfs:label ?factorLabel. ?indicator rdfs:label ?indicatorLabel.
 OPTIONAL { ?assessment a:st ?st }
 OPTIONAL { ?assessment a:ce ?ce }
 OPTIONAL { ?assessment a:category ?category }
 BIND(COALESCE(?status IN ("reported", "complete") && ?st > ?tauST && ABS(?ce) > ?tauCE, false) AS ?selected)
 BIND(EXISTS { ?edge a:inMap ?map; a:basedOn ?assessment } AS ?hasEdge)
 BIND(IF(?status = "undefined", "Оценки не определены",
        IF(?status = "No_ST", "Статус No_ST: ST не положителен при модуле CE не менее ceLow",
        IF(?status NOT IN ("reported", "complete"), "Статус оценки не допускает включения",
        IF(?selected, "Оба строгих порога пройдены",
           "Хотя бы один строгий порог не пройден")))) AS ?reason)
 OPTIONAL { ?assessment a:sourceLocator ?sourceLocator }
 OPTIONAL { ?assessment a:evidenceNote ?evidenceNote }
 OPTIONAL { ?assessment a:ate ?ate }
 OPTIONAL { ?assessment a:sensitivity/a:method ?sensitivityMethod }
 OPTIONAL { ?assessment a:sensitivity/a:softwareVersion ?sensitivityVersion }
 OPTIONAL { ?assessment a:sensitivity/a:analysisSettings ?sensitivitySettings }
 OPTIONAL { ?assessment a:estimation/a:method ?method }
 OPTIONAL { ?assessment a:estimation/a:softwareVersion ?softwareVersion }
 OPTIONAL { ?assessment a:estimation/a:controlValue ?controlValue }
 OPTIONAL { ?assessment a:estimation/a:treatmentValue ?treatmentValue }
 OPTIONAL { ?assessment a:normalization/a:formula ?formula }
 OPTIONAL { ?assessment a:normalization/a:sigmaX ?sigmaX }
 OPTIONAL { ?assessment a:normalization/a:sigmaY ?sigmaY }
}
ORDER BY ?assessment
