    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ru">отнесена к категории</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#InfluenceAssessment"/>
    <rdfs:range rdf:resource="https://w3id.org/km-energy/ontology#LinkCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#adjustmentSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ru">набор корректировки, включая явный пустой</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#EstimationSpecification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#DecisionVariable">
    <rdfs:comment xml:lang="ru">Величина, оптимальные значения которой определяет оптимизационная модель. Не является скрытым промежуточным слоем Z каузальной карты статьи.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Переменные решения</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Набор данных для анализа Dxy</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b16"/>
    <rdfs:comment xml:lang="ru">Исходные сценарные значения X и Y. Оценка использует этот набор; агрегированные ST и CE не являются строками исходного Dxy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#computesCE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/km-energy/ontology#EffectEstimation"/>
    <rdfs:range rdf:resource="https://w3id.org/km-energy/ontology#DirectedEffect"/>
