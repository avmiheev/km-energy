    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b54"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b55"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b56"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b57"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b58"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b59"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b60"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b61"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b62"/>
    <rdfs:subClassOf rdf:nodeID="n499cb77f6ced4686b04c604702771a90b63"/>
    <rdfs:comment xml:lang="ru">Запись оценки пары фактор–показатель в одном эксперименте и на одном наборе данных; ST и CE относятся к этой записи. Одна и та же пара в январе и июле имеет разные записи оценки.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/km-energy/ontology#stLow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
